{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": false
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "actions/**/*.ts",
    "hooks/**/*.ts",
    "styles/**/*.ts"
  ],
  "exclude": ["dist", "node_modules", "**/*.{test,spec}.ts"]
}
