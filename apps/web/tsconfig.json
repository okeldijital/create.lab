{
  "extends":"../../tsconfig.base.json",
  "compilerOptions":{
    "outDir":"dist",
    "rootDir":".",
    "lib":["ES2022","DOM","DOM.Iterable"],
    "module":"ESNext",
    "moduleResolution":"Bundler",
    "jsx":"preserve",
    "noEmit":true,
    "incremental":true,
    "strict":true,
    "allowJs":false,
    "plugins":[{"name":"next"}]
  },
  "include":["next-env.d.ts",".next/types/**/*.ts","app/**/*.ts","app/**/*.tsx","components/**/*.ts","components/**/*.tsx","lib/**/*.ts","actions/**/*.ts","hooks/**/*.ts"],
  "exclude":["dist","node_modules","**/*.{test,spec}.ts"]
}
