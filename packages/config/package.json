{
  "name": "@creative-lab/config",
  "version": "0.0.0",
  "private": true,
  "description": "Creative Lab shared platform configuration presets (BUILD-000A)",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.mjs",
    "./prettier": "./prettier/index.json",
    "./typescript/base": "./typescript/base.json",
    "./typescript/library": "./typescript/library.json",
    "./tailwind": "./tailwind/index.ts",
    "./vitest": "./vitest/index.ts",
    "./commitlint": "./commitlint/index.cjs",
    "./lint-staged": "./lint-staged/index.cjs",
    "./shared/constants": "./shared/constants.json"
  },
  "files": [
    "eslint",
    "prettier",
    "typescript",
    "tailwind",
    "vitest",
    "commitlint",
    "lint-staged",
    "shared"
  ],
  "scripts": {
    "build": "mkdir -p dist && node -e \"require('fs').writeFileSync('dist/.build-stamp', new Date().toISOString())\"",
    "typecheck": "node -e \"process.exit(0)\"",
    "lint": "node -e \"process.exit(0)\"",
    "test": "node -e \"process.exit(0)\"",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@eslint/js": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "typescript-eslint": "^8.18.2"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  }
}
