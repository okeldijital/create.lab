{
  "name": "creative-lab",
  "version": "0.0.0",
  "private": true,
  "description": "Creative Lab platform monorepo — engineering foundation",
  "packageManager": "pnpm@9.15.0",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:deps": "node scripts/check-deps.mjs",
    "typecheck": "turbo run typecheck",
    "acceptance:auth": "node scripts/auth-acceptance.mjs",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}\"",
    "check": "pnpm run lint:deps && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "dependencies": {
    "next": "15.5.21",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  },
  "prettier": "./packages/config/prettier/index.json"
}
